{
  "name": "remotehub-desktop",
  "version": "0.1.0-beta.8",
  "private": true,
  "description": "Cross-platform SSH, SFTP, FTP and database workbench",
  "author": "cb-gif",
  "homepage": "https://github.com/cb-gif/remotehub-desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/cb-gif/remotehub-desktop.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist-electron/main/index.js",
  "type": "commonjs",
  "scripts": {
    "postinstall": "node scripts/rebuild-native.mjs",
    "dev": "npm run build && concurrently -k \"vite preview --configLoader native --host 127.0.0.1 --port 5173\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build": "vite build --configLoader native && tsc -p tsconfig.node.json",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern dist-electron",
    "test": "node scripts/run-tests.mjs",
    "start": "electron .",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "pack": "npm run build && electron-builder --dir --publish never",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --x64 --publish never",
    "test:packaged": "node scripts/smoke-packaged.mjs",
    "release:checksums": "node scripts/release-checksums.mjs",
    "release:verify": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/noto-sans-sc": "^5.2.8",
    "basic-ftp": "^6.2.1",
    "better-sqlite3": "^11.8.1",
    "codemirror": "^6.0.1",
    "iconv-lite": "^0.7.3",
    "mysql2": "^3.24.2",
    "node-pty": "^1.1.0",
    "pg": "^8.23.0",
    "pinia": "^2.3.0",
    "serialport": "^13.0.0",
    "ssh2": "^1.17.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "electron": "^34.0.0",
    "electron-builder": "26.15.3",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^10.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0",
    "wait-on": "^8.0.1"
  }
}
